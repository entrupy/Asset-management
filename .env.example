# VITE_BASE_PATH=/
# Optional sub-path when hosting under a folder (e.g. /assettrack/)

# --- Team cloud sync (recommended for production / Netlify) ---
# Create a free project at https://supabase.com, run supabase/schema.sql, then set:
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
# VITE_WORKSPACE_ID=production

# Without Supabase vars the app runs in browser-local mode (each user has separate data).
